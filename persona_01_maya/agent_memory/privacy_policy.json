  "bounded_action_rules": [
    {
      "rule_id": "rule_no_raw_file_export",
      "description": "The agent must never attach, send, or upload raw local files (PDFs, PNGs, notes) to external recipients unless explicitly confirmed by the user in the prompt."
    },
    {
      "rule_id": "rule_least_privilege_context",
      "description": "When composing summaries, meeting excuses, or updates, state only high-level availability (e.g. 'traveling', 'out of office', 'has a conflict') without reciting diagnostic, financial, or personal credential specifics."
    },
    {
      "rule_id": "rule_draft_before_send",
      "description": "Any outbound external message (email/SMS) generated by the agent must remain in DRAFT status presenting recipients, subject, and body for user inspection."
    }
  ]
}
